# LLM used by api/llm_client.py for the natural-language reasoning step in /ask.
# Any single provider is fine per the problem statement (no restriction on tools) —
# Anthropic is used here directly via HTTPS, with no agent framework in between.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: only needed if you pull the dataset via the Roboflow API in prepare_dataset.py
ROBOFLOW_API_KEY=

# Detector weights path used by the API at startup
MODEL_WEIGHTS_PATH=runs/ppe/rtdetr_ppe_v1/weights/best.pt
DETECT_CONF_THRESHOLD=0.35
